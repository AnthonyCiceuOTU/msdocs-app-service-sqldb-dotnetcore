@model DotNetCoreSqlDb.ViewModels.CountersViewModel

@{
    ViewData["Title"] = "Counters & Accumulators";
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .lesson-page {
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: 16px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lesson-shell {
        max-width: 1100px;
        height: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #f8fafc;
    }

    .brand-text h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.1;
    }

    .brand-text p {
        margin: 4px 0 0 0;
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .step-panel {
        flex: 1;
        min-height: 0;
        display: flex;
    }

    .step-card {
        width: 100%;
        padding: 18px 20px;
        display: none;
        overflow: hidden;
    }

    .step-card.active {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .step-top h2,
    .step-top h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        line-height: 1.15;
    }

    .step-top h2 { font-size: 1.65rem; }
    .step-top h3 { font-size: 1.3rem; }

    .step-top p {
        margin: 0 0 10px 0;
        color: #94a3b8;
        line-height: 1.5;
        font-size: 0.95rem;
    }

    .instruction-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px 14px;
        color: #cbd5e1;
        line-height: 1.5;
        font-size: 0.94rem;
        margin-bottom: 10px;
    }

    .code-block {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
        font-family: Consolas, Monaco, monospace;
        white-space: pre-wrap;
        line-height: 1.45;
        font-size: 0.92rem;
        margin-bottom: 10px;
    }

    .quiz-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        align-items: start;
    }

    .quiz-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px;
    }

    .quiz-title {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .mini-code {
        background: rgba(2, 6, 23, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 10px;
        padding: 10px 12px;
        color: #e2e8f0;
        font-family: Consolas, Monaco, monospace;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        background: rgba(2, 6, 23, 0.7);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        font-size: 0.92rem;
    }

    .text-input:focus {
        border-color: rgba(34, 197, 94, 0.5);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
    }

    .concept-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 8px;
    }

    .concept-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 12px;
    }

    .concept-card h4 {
        margin: 0 0 6px 0;
        color: #ffffff;
        font-size: 0.95rem;
    }

    .concept-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .mc-grid {
        display: grid;
        gap: 10px;
    }

    .mc-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .mc-header {
        color: #e5e7eb;
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .btn-main,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 16px;
        cursor: pointer;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .btn-main:hover,
    .btn-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        color: #ffffff;
    }

    .btn-main:disabled,
    .btn-secondary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .step-progress {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .alert-box {
        border-radius: 12px;
        padding: 10px 12px;
        margin-top: 10px;
        border: 1px solid transparent;
        font-size: 0.92rem;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .alert-info-custom {
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .loading-box {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border: 1px solid rgba(59, 130, 246, 0.2);
        font-size: 0.92rem;
    }

    .loading-box.active {
        display: inline-flex;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(191, 219, 254, 0.25);
        border-top-color: #bfdbfe;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex: 0 0 auto;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .nav-footer {
        margin-top: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    @@media (max-width: 900px) {
        .brand-text h1 { font-size: 1.7rem; }
        .step-top h2 { font-size: 1.4rem; }
        .step-top h3 { font-size: 1.15rem; }

        .step-card {
            padding: 16px;
            overflow-y: auto;
        }

        .quiz-grid,
        .concept-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                    <p>Unit 4 · Counters</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form asp-action="Counters" asp-controller="UnitFour" method="post" id="lessonForm">
            @Html.AntiForgeryToken()
            <input asp-for="ExplanationCorrect" type="hidden" id="ExplanationCorrectHidden" />
            <input asp-for="ExplanationFeedback" type="hidden" id="ExplanationFeedbackHidden" />

            <div class="panel step-panel">
                <div class="step-card active" id="step0">
                    <div class="step-top">
                        <h2>Counters & Accumulators</h2>
                        <p>
                            Counters and accumulators help a program keep track of values while a loop runs.
                            A counter tracks how many times something happens, and an accumulator keeps a running total.
                        </p>

                        <div class="code-block">sum = 0
FOR i = 1 TO 10
    sum = sum + i
END FOR</div>

                        <div class="instruction-box">
                            In this lesson, you will first practice identifying how an accumulator works,
                            then explain why counters and accumulators are useful in programming.
                        </div>

                        <div class="concept-grid">
                            <div class="concept-card">
                                <h4>Counter</h4>
                                <p>Keeps track of how many times something happens.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Accumulator</h4>
                                <p>Keeps a running total by adding values over time.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Loop Update</h4>
                                <p>The tracked value changes each time the loop repeats.</p>
                            </div>
                        </div>

                        @if (Model.ShowHint)
                        {
                            <div class="alert-box alert-info-custom">
                                Think about which variable stores the total and how it changes each loop.
                            </div>
                        }

                        @if (Model.ShowSolution)
                        {
                            <div class="alert-box alert-info-custom">
                                An accumulator stores a running total, often with an update like <b>sum = sum + i</b>.
                            </div>
                        }
                    </div>

                    <div class="step-actions">
                        <span class="step-progress">Step 1 of 2</span>
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Practice</h3>
                        <p>Answer these questions about counters and accumulators.</p>

                        <div class="quiz-grid">
                            <div class="quiz-card">
                                <div class="quiz-title">1. Which variable stores the running total?</div>
                                <div class="mini-code">sum = 0
FOR i = 1 TO 10
    sum = sum + i
END FOR</div>
                                <input asp-for="UserAnswer1" class="text-input" placeholder="Type your answer" />
                                @if (Model.IsQ1Correct != null)
                                {
                                    <div class="alert-box @(Model.IsQ1Correct == true ? "alert-success-custom" : "alert-danger-custom")">
                                        @Model.Feedback1
                                    </div>
                                }
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">2. What does an accumulator keep track of?</div>
                                <input asp-for="UserAnswer2" class="text-input" placeholder="Type your answer" />
                                @if (Model.IsQ2Correct != null)
                                {
                                    <div class="alert-box @(Model.IsQ2Correct == true ? "alert-success-custom" : "alert-danger-custom")">
                                        @Model.Feedback2
                                    </div>
                                }
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">3. Which line updates the total in the loop?</div>
                                <input asp-for="UserAnswer3" class="text-input" placeholder="Type the line of code" />
                                @if (Model.IsQ3Correct != null)
                                {
                                    <div class="alert-box @(Model.IsQ3Correct == true ? "alert-success-custom" : "alert-danger-custom")">
                                        @Model.Feedback3
                                    </div>
                                }
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">4. What do we call a variable that stores a running total?</div>
                                <input asp-for="UserAnswer4" class="text-input" placeholder="Type your answer" />
                                @if (Model.IsQ4Correct != null)
                                {
                                    <div class="alert-box @(Model.IsQ4Correct == true ? "alert-success-custom" : "alert-danger-custom")">
                                        @Model.Feedback4
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 2</div>

                        @if (Model.IsQ1Correct == true && Model.IsQ2Correct == true && Model.IsQ3Correct == true && Model.IsQ4Correct == true)
                        {
                            <button type="button" class="btn-main" onclick="showStep(2)">Next</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button type="submit" name="actionType" value="check" class="btn-main">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary">Solution</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top">
                        <h3>Explain the Idea</h3>
                        <p>Use your own words to explain why counters or accumulators are useful in programming.</p>

                        <div class="instruction-box">
                            A strong answer should mention tracking values in a loop, like counting events or keeping a running total.
                        </div>

                        <div class="mc-grid">
                            <div class="mc-card">
                                <div class="mc-header">Your explanation</div>
                                <input asp-for="ExplanationAnswer"
                                       class="text-input"
                                       id="ExplanationAnswer"
                                       placeholder="Example: They help a program keep track of totals or counts while a loop repeats." />
                            </div>

                            <div class="mc-card">
                                <div class="mc-header">AI feedback</div>
                                <textarea id="aiFeedbackDisplay"
                                          class="text-input"
                                          rows="4"
                                          readonly
                                          placeholder="AI feedback will appear here.">@Model.ExplanationFeedback</textarea>
                            </div>
                        </div>

                        <div id="aiLoadingBox" class="loading-box">
                            <div class="spinner"></div>
                            <span>Checking with AI.</span>
                        </div>

                        <div id="aiFeedbackAlert"
                             class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")"
                             style="@(string.IsNullOrWhiteSpace(Model.ExplanationFeedback) ? "display:none;" : "")">
                            @Model.ExplanationFeedback
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)" id="backToStep1Button">Back</button>
                        <div class="step-progress">Step 2 of 2</div>

                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button type="button" class="btn-main" id="checkExplanationButton">Check</button>
                            <button type="submit"
                                    name="actionType"
                                    value="submit"
                                    class="btn-main"
                                    id="submitLessonButton"
                                    style="@(Model.ExplanationCorrect == true ? "" : "display:none;")">
                                Submit Lesson
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="UnitFour" asp-action="ForLoops" class="btn-secondary">Back to Previous Lesson</a>
            <a asp-controller="Lessons" asp-action="Index" class="btn-main">Back to Lessons</a>
        </div>
    </div>
</div>

<script>
    function showStep(stepNumber) {
        document.querySelectorAll('.step-card').forEach(card => {
            card.classList.remove('active');
        });

        const target = document.getElementById(`step${stepNumber}`);
        if (target) {
            target.classList.add('active');
        }
    }

    function setStepTwoLoadingState(isLoading) {
        const loadingBox = document.getElementById('aiLoadingBox');
        const checkButton = document.getElementById('checkExplanationButton');
        const backButton = document.getElementById('backToStep1Button');
        const explanationInput = document.getElementById('ExplanationAnswer');

        if (loadingBox) {
            loadingBox.classList.toggle('active', isLoading);
        }

        if (checkButton) {
            checkButton.disabled = isLoading;
            checkButton.textContent = isLoading ? 'Checking.' : 'Check';
        }

        if (backButton) {
            backButton.disabled = isLoading;
        }

        if (explanationInput) {
            explanationInput.readOnly = isLoading;
        }
    }

    function setAiResult(isCorrect, feedback) {
        const feedbackDisplay = document.getElementById('aiFeedbackDisplay');
        const feedbackAlert = document.getElementById('aiFeedbackAlert');
        const submitLessonButton = document.getElementById('submitLessonButton');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
        const explanationFeedbackHidden = document.getElementById('ExplanationFeedbackHidden');

        if (feedbackDisplay) {
            feedbackDisplay.value = feedback || '';
        }

        if (feedbackAlert) {
            feedbackAlert.style.display = 'block';
            feedbackAlert.textContent = feedback || '';
            feedbackAlert.classList.remove('alert-success-custom', 'alert-danger-custom');
            feedbackAlert.classList.add(isCorrect ? 'alert-success-custom' : 'alert-danger-custom');
        }

        if (explanationCorrectHidden) {
            explanationCorrectHidden.value = isCorrect ? 'true' : 'false';
        }

        if (explanationFeedbackHidden) {
            explanationFeedbackHidden.value = feedback || '';
        }

        if (submitLessonButton) {
            submitLessonButton.style.display = isCorrect ? '' : 'none';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const forcedStep = '@(ViewBag.ForceStep ?? "")';

        if (forcedStep !== '') {
            showStep(parseInt(forcedStep));
        } else {
            const q1 = '@(Model.IsQ1Correct?.ToString() ?? "")'.toLowerCase();
            const q2 = '@(Model.IsQ2Correct?.ToString() ?? "")'.toLowerCase();
            const q3 = '@(Model.IsQ3Correct?.ToString() ?? "")'.toLowerCase();
            const q4 = '@(Model.IsQ4Correct?.ToString() ?? "")'.toLowerCase();
            const explanationDone = '@(Model.ExplanationCorrect?.ToString() ?? "")'.toLowerCase();

            const stepOneComplete =
                q1 === 'true' &&
                q2 === 'true' &&
                q3 === 'true' &&
                q4 === 'true';

            if (explanationDone === 'true') {
                showStep(2);
            } else if (stepOneComplete) {
                showStep(2);
            } else {
                showStep(0);
            }
        }

        const checkExplanationButton = document.getElementById('checkExplanationButton');
        const explanationInput = document.getElementById('ExplanationAnswer');
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (checkExplanationButton && explanationInput && tokenInput) {
            checkExplanationButton.addEventListener('click', async function () {
                const explanation = explanationInput.value.trim();

                if (!explanation) {
                    setAiResult(false, 'Please enter an explanation first.');
                    return;
                }

                setStepTwoLoadingState(true);

                try {
                    const formData = new FormData();
                    formData.append('explanationAnswer', explanation);
                    formData.append('__RequestVerificationToken', tokenInput.value);

                    const response = await fetch('/UnitFour/CheckCountersExplanation', {
                        method: 'POST',
                        body: formData
                    });

                    let data = null;
                    try {
                        data = await response.json();
                    } catch {
                        data = null;
                    }

                    if (!response.ok) {
                        const message = data && data.feedback
                            ? data.feedback
                            : 'We could not check your explanation right now. Please try again.';
                        setAiResult(false, message);
                        return;
                    }

                    setAiResult(!!data.isCorrect, data.feedback || '');
                } catch (error) {
                    setAiResult(false, 'We could not check your explanation right now. Please try again.');
                } finally {
                    setStepTwoLoadingState(false);
                }
            });
        }
    });
</script>