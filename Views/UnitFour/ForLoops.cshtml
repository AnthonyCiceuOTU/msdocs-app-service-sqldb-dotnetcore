@model DotNetCoreSqlDb.ViewModels.ForLoopsViewModel

<div class="container mt-4">
    <h1>FOR Loops</h1>

    <pre class="bg-light p-3 border rounded">
FOR i ← 1 TO 10
    PRINT i
END FOR
    </pre>


    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Try it yourself</h5>
            <p class="text-muted">Modify the loop and run it to see what happens.</p>

            <textarea id="code" class="form-control mb-3" style="font-family: monospace; height: 200px;">
FOR i = 1 TO 5
    PRINT i
ENDFOR
            </textarea>

            <div class="d-flex gap-2 mb-3">
                <button type="button" class="btn btn-primary" onclick="runCode()">Run ▶</button>
                <button type="button" class="btn btn-secondary" onclick="resetCode()">Reset</button>
            </div>

            <div id="output" class="bg-dark text-success p-3 rounded" style="min-height: 120px; white-space: pre-wrap;">
Output will appear here...
            </div>
        </div>
    </div>

    <!-- ORIGINAL QUESTION -->
    <p class="mt-4">When would you use a FOR loop?</p>

    <form method="post">
        <input asp-for="UserAnswer" class="form-control mb-3" />

        <button name="actionType" value="submit" class="btn btn-primary">Submit</button>
        <button name="actionType" value="hint" class="btn btn-warning">Hint</button>
        <button name="actionType" value="solution" class="btn btn-success">Solution</button>
    </form>

    @if (Model.ShowHint)
    {
        <div class="alert alert-warning mt-3">
            Think about when you know how many times to repeat something.
        </div>
    }

    @if (Model.ShowSolution)
    {
        <div class="alert alert-success mt-3">
            FOR loops are used when the number of iterations is known.
        </div>
    }

    @if (Model.IsCorrect != null)
    {
        <div class="alert @(Model.IsCorrect == true ? "alert-success" : "alert-danger") mt-3">
            @Model.FeedbackMessage
        </div>
    }
</div>

//import interpreter
<script type="module">
    import { runCode } from '/js/interpreter/uiRunner.js';


    window.runCode = runCode;


    window.resetCode = function () {
        document.getElementById("code").value =
`FOR i = 1 TO 5
    PRINT i
ENDFOR`;

        document.getElementById("output").textContent = "Output will appear here...";
    };
</script>
