@using System
@model DotNetCoreSqlDb.ViewModels.LessonsIndexViewModel

@{
    ViewData["Title"] = "Lessons";
}

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        width: 100%;
    }

    body {
        overflow-x: hidden;
    }

    .lessons-page {
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: clamp(12px, 2vw, 24px);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lessons-shell {
        max-width: 1500px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: clamp(12px, 1.5vw, 18px);
        box-sizing: border-box;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-icon {
        width: clamp(42px, 5vw, 48px);
        height: clamp(42px, 5vw, 48px);
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: clamp(16px, 2vw, 18px);
        color: #f8fafc;
        flex-shrink: 0;
    }

    .brand-text h1 {
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 2rem);
        font-weight: 700;
        color: #ffffff;
        line-height: 1.1;
    }

    .topbar-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .lessons-hero {
        padding: clamp(14px, 2vw, 20px);
        display: grid;
        gap: clamp(14px, 1.8vw, 18px);
    }

    .course-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        flex-wrap: wrap;
    }

    .course-header h2 {
        margin: 0;
        font-size: clamp(1.2rem, 2.2vw, 1.45rem);
        color: #ffffff;
    }

    .course-header p {
        margin: 4px 0 0 0;
        color: #94a3b8;
        font-size: clamp(0.9rem, 1.6vw, 0.95rem);
        line-height: 1.55;
        max-width: 760px;
    }

    .lessons-layout {
        display: grid;
        grid-template-columns: minmax(320px, 0.85fr) minmax(0, 1.55fr);
        grid-template-areas: "content units";
        gap: clamp(14px, 1.8vw, 18px);
        align-items: start;
    }

    .units-panel,
    .lesson-content {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 16px;
        padding: clamp(14px, 1.8vw, 18px);
        min-width: 0;
    }

    .units-panel {
        grid-area: units;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .section-kicker {
        color: #22c55e;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .section-title {
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        margin: 2px 0 0 0;
    }

    .section-subtitle {
        color: #94a3b8;
        font-size: 0.9rem;
        margin: 6px 0 0 0;
        line-height: 1.5;
    }

    .units-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
    }

    .unit-card {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 14px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        min-width: 0;
    }

    .unit-title {
        color: #f8fafc;
        font-weight: 700;
        font-size: 0.98rem;
        line-height: 1.3;
    }

    .unit-description {
        color: #94a3b8;
        font-size: 0.85rem;
        line-height: 1.5;
        min-height: 54px;
    }

    .lesson-links {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .lesson-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        border-radius: 10px;
        text-decoration: none;
        color: #cbd5e1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        transition: 0.2s ease;
        font-size: 0.88rem;
        line-height: 1.3;
        min-height: 42px;
        box-sizing: border-box;
        overflow: hidden;
    }

    .lesson-link span:first-child {
        overflow-wrap: anywhere;
        word-break: break-word;
        min-width: 0;
    }

    .lesson-link:hover {
        color: #ffffff;
        border-color: rgba(34, 197, 94, 0.45);
        background: rgba(255,255,255,0.07);
        transform: translateY(-1px);
    }

    .lesson-link.current {
        border-color: rgba(14, 165, 233, 0.65);
        background: rgba(14, 165, 233, 0.12);
        color: #ffffff;
    }

    .lesson-link.completed {
        border-color: rgba(34, 197, 94, 0.18);
    }

    .lesson-status {
        font-weight: 700;
        color: #22c55e;
        flex: 0 0 auto;
        font-size: 0.9rem;
    }

    .lesson-content {
        grid-area: content;
        display: grid;
        gap: 14px;
        align-content: start;
        position: sticky;
        top: 12px;
    }

    .lesson-meta-card,
    .info-card,
    .overview-card,
    .help-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 14px;
        padding: clamp(12px, 1.6vw, 16px);
    }

    .lesson-breadcrumb {
        color: #22c55e;
        margin-bottom: 10px;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .lesson-content h1 {
        margin: 0 0 10px 0;
        color: #ffffff;
        font-size: clamp(1.55rem, 2.8vw, 1.95rem);
        line-height: 1.15;
    }

    .lesson-description {
        color: #94a3b8;
        margin-bottom: 0;
        line-height: 1.6;
        font-size: 0.96rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .mini-label {
        color: #94a3b8;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 6px;
    }

    .mini-value {
        color: #f8fafc;
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .help-card h3,
    .overview-card h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        font-size: 0.98rem;
    }

    .help-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .overview-content {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-height: 260px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .empty-state h1 {
        color: #ffffff;
        margin-top: 0;
    }

    .empty-state p,
    .muted {
        color: #94a3b8;
    }

    .lesson-actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        align-items: stretch;
    }

    .nav-buttons {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        min-width: 0;
    }

    .complete-form {
        display: flex;
        width: 100%;
        min-width: 0;
    }

    .btn-main,
    .btn-secondary,
    .btn-success,
    .btn-disabled {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 14px;
        cursor: pointer;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.25;
        font-size: 0.92rem;
        min-height: 42px;
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .btn-success {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: white;
    }

    .btn-disabled {
        background: rgba(255,255,255,0.03);
        color: #64748b;
        border-color: rgba(255,255,255,0.05);
        cursor: not-allowed;
        pointer-events: none;
    }

    .btn-main:hover,
    .btn-secondary:hover,
    .btn-success:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        color: #ffffff;
    }

    .topbar-btn {
        width: auto;
        min-width: 110px;
        padding: 10px 16px;
    }

    form {
        margin: 0;
    }

    @@media (max-width: 1200px) {
        .lessons-layout {
            grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.3fr);
            grid-template-areas: "content units";
        }

        .units-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1100px) {
        .lessons-layout {
            grid-template-columns: 1fr;
            grid-template-areas:
                "content"
                "units";
        }

        .lesson-content {
            position: static;
        }
    }

    @@media (max-width: 900px) {
        .lessons-page {
            padding: 14px;
        }

        .lessons-hero,
        .units-panel,
        .lesson-content {
            padding: 14px;
        }

        .brand-text h1 {
            font-size: 1.7rem;
        }

        .lesson-content h1 {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 680px) {
        .topbar {
            align-items: stretch;
        }

        .topbar-actions {
            display: grid;
            grid-template-columns: 1fr;
            width: 100%;
        }

        .topbar-btn {
            width: 100%;
        }

        .units-grid {
            grid-template-columns: 1fr;
        }

        .info-grid,
        .nav-buttons {
            grid-template-columns: 1fr;
        }

        .lesson-link {
            font-size: 0.84rem;
            min-height: 38px;
        }

        .btn-main,
        .btn-secondary,
        .btn-success,
        .btn-disabled {
            font-size: 0.88rem;
            padding: 9px 12px;
        }
    }

    @@media (max-width: 480px) {
        .lessons-page {
            padding: 10px;
        }

        .brand {
            gap: 10px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            font-size: 15px;
        }

        .brand-text h1 {
            font-size: 1.45rem;
        }

        .course-header h2 {
            font-size: 1.1rem;
        }

        .lesson-content h1 {
            font-size: 1.4rem;
        }

        .units-panel,
        .lesson-content,
        .lessons-hero {
            padding: 12px;
        }
    }
</style>

<div class="lessons-page">
    <div class="lessons-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                </div>
            </div>

            <div class="topbar-actions">
                <a asp-controller="Home" asp-action="Index" class="btn-secondary topbar-btn">
                    Home
                </a>
                <a asp-controller="Profile" asp-action="Index" class="btn-secondary topbar-btn">
                    Profile
                </a>
            </div>
        </div>

        <div class="panel lessons-hero">
            <div class="course-header">
                <div>
                    <h2>Course Content</h2>
                    <p>Select any lesson on the right. The left panel gives a quick preview, and the main action button starts the selected lesson.</p>
                </div>
            </div>

            <div class="lessons-layout">
                <section class="units-panel">
                    <div>
                        <div class="section-kicker">Lesson Browser</div>
                        <div class="section-title">Browse by unit</div>
                        <p class="section-subtitle">Pick a unit, choose a lesson, then start it from the preview panel on the left.</p>
                    </div>

                    @if (!Model.Units.Any())
                    {
                        <p class="muted">No lessons available yet.</p>
                    }
                    else
                    {
                        <div class="units-grid">
                            @foreach (var unit in Model.Units.OrderBy(u => u.SortOrder))
                            {
                                <div class="unit-card">
                                    <div class="unit-title">@unit.Title</div>

                                    @if (!string.IsNullOrWhiteSpace(unit.Description))
                                    {
                                        <div class="unit-description">@unit.Description</div>
                                    }

                                    <div class="lesson-links">
                                        @foreach (var lesson in unit.Lessons
                                            .Where(l => !string.Equals(l.Title, "Unit Two Overview", StringComparison.OrdinalIgnoreCase))
                                            .OrderBy(l => l.SortOrder))
                                        {
                                            var cssClass = "lesson-link";
                                            if (lesson.IsCurrent) cssClass += " current";
                                            if (lesson.IsCompleted) cssClass += " completed";

                                            <a asp-controller="Lessons"
                                               asp-action="Index"
                                               asp-route-lessonId="@lesson.LessonId"
                                               class="@cssClass">
                                                <span>@lesson.Title</span>

                                                @if (lesson.IsCompleted)
                                                {
                                                    <span class="lesson-status">✓</span>
                                                }
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <main class="lesson-content">
                    @if (Model.CurrentLessonId == null)
                    {
                        <div class="empty-state">
                            <h1>No lesson selected</h1>
                            <p>Select a lesson from the units panel.</p>
                        </div>
                    }
                    else
                    {
                        <div class="lesson-meta-card">
                            <div class="lesson-breadcrumb">
                                @Model.CurrentUnitTitle
                            </div>

                            <h1>@Model.CurrentLessonTitle</h1>

                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLessonDescription))
                            {
                                <p class="lesson-description">@Model.CurrentLessonDescription</p>
                            }
                        </div>

                        <div class="overview-card">
                            <h3>Lesson Overview</h3>

                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLessonContent))
                            {
                                <div class="overview-content">@Model.CurrentLessonContent</div>
                            }
                            else
                            {
                                <div class="overview-content">No lesson content available yet.</div>
                            }
                        </div>

                        <div class="lesson-actions">
                            <div class="nav-buttons">
                                @if (Model.PreviousLessonId != null)
                                {
                                    <a asp-controller="Lessons"
                                       asp-action="Index"
                                       asp-route-lessonId="@Model.PreviousLessonId"
                                       class="btn-secondary">
                                        ← Previous
                                    </a>
                                }
                                else
                                {
                                    <span class="btn-disabled">← Previous</span>
                                }

                                <a asp-controller="Lessons"
                                   asp-action="Open"
                                   asp-route-lessonId="@Model.CurrentLessonId"
                                   class="btn-main">
                                    Start Lesson
                                </a>

                                @if (Model.NextLessonId != null)
                                {
                                    <a asp-controller="Lessons"
                                       asp-action="Index"
                                       asp-route-lessonId="@Model.NextLessonId"
                                       class="btn-secondary">
                                        Next →
                                    </a>
                                }
                                else
                                {
                                    <span class="btn-disabled">Next →</span>
                                }
                            </div>

                            <form asp-controller="Lessons" asp-action="Complete" method="post" class="complete-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lessonId" value="@Model.CurrentLessonId" />

                                @if (Model.CurrentLessonCompleted)
                                {
                                    <button type="submit" class="btn-success">Completed ✓</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-main">Mark Complete</button>
                                }
                            </form>
                        </div>
                    }
                </main>
            </div>
        </div>
    </div>
</div>