@model DotNetCoreSqlDb.ViewModels.AccessingViewModel

@{
    ViewData["Title"] = "Accessing";
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .lesson-page {
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: 16px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lesson-shell {
        max-width: 1100px;
        height: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #f8fafc;
    }

    .brand-text h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.1;
    }

    .brand-text p {
        margin: 4px 0 0 0;
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .step-panel {
        flex: 1;
        min-height: 0;
        display: flex;
    }

    .step-card {
        width: 100%;
        padding: 18px 20px;
        display: none;
        overflow: hidden;
    }

    .step-card.active {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .step-top h2, .step-top h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        line-height: 1.15;
    }

    .step-top h2 { font-size: 1.65rem; }
    .step-top h3 { font-size: 1.3rem; }

    .step-top p {
        margin: 0 0 10px 0;
        color: #94a3b8;
        line-height: 1.5;
        font-size: 0.95rem;
    }

    .instruction-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px 14px;
        color: #cbd5e1;
        line-height: 1.5;
        font-size: 0.94rem;
        margin-bottom: 10px;
    }

    .code-block {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
        font-family: Consolas, Monaco, monospace;
        white-space: pre-wrap;
        line-height: 1.45;
        font-size: 0.92rem;
        margin-bottom: 10px;
    }

    .concept-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 8px;
    }

    .concept-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 12px;
    }

    .concept-card h4 {
        margin: 0 0 6px 0;
        color: #ffffff;
        font-size: 0.95rem;
    }

    .concept-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .quiz-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px;
        max-width: 720px;
    }

    .quiz-title {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 0.95rem;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        background: rgba(2, 6, 23, 0.7);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        font-size: 0.92rem;
    }

    .mc-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .mc-option {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: rgba(2, 6, 23, 0.55);
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 10px;
        padding: 10px 12px;
        color: #e5e7eb;
        line-height: 1.45;
        cursor: pointer;
    }

    .mc-option input[type="radio"] {
        margin-top: 3px;
        flex-shrink: 0;
    }

    .btn-main, .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 16px;
        cursor: pointer;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .step-progress {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .alert-box {
        border-radius: 12px;
        padding: 10px 12px;
        margin-top: 10px;
        border: 1px solid transparent;
        font-size: 0.92rem;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .alert-info-custom {
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .nav-footer {
        margin-top: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    @@media (max-width: 900px) {
        .concept-grid {
            grid-template-columns: 1fr;
        }

        .step-card {
            padding: 16px;
            overflow-y: auto;
        }
    }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">[]</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                    <p>Unit 5 · Accessing Elements</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form asp-action="Accessing" asp-controller="UnitFive" method="post" id="lessonForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="activeStepInput" name="activeStep" value="0" />

            <div class="panel step-panel">
                <div class="step-card active" id="step0">
                    <div class="step-top">
                        <h2>Accessing Elements</h2>
                        <p>Each item in a list has a position number, and that position helps us access the value we want.</p>

                        <div class="code-block">scores ← [80, 75, 90]
firstScore ← scores[0]</div>

                        <div class="instruction-box">In this lesson, you will first fill in the word for a list position, then answer a multiple-choice question about accessing the first item.</div>

                        <div class="concept-grid">
                            <div class="concept-card">
                                <h4>Index</h4>
                                <p>An index is the position of an item in a list.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Starts at 0</h4>
                                <p>The first item is usually at position 0.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Square Brackets</h4>
                                <p>Indexes are commonly used inside square brackets.</p>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <div class="step-progress">Instructions</div>
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Step 1 · Fill in the blank</h3>

                        <div class="instruction-box">Complete the missing keyword, then move to the next step.</div>

                        <div class="quiz-card">
                            <div class="quiz-title">Fill in the blank: The position of an item in a list is called an ____.</div>
                            <input asp-for="UserAnswer" class="text-input" placeholder="Type one word" />
                        </div>

                        @if (Model.ShowHint && (ViewBag.ActiveStep ?? 0) == 1)
                        {
                            <div class="alert-box alert-info-custom">@Model.FeedbackMessage</div>
                        }

                        @if (Model.ShowSolution && (ViewBag.ActiveStep ?? 0) == 1)
                        {
                            <div class="alert-box alert-info-custom">@Model.FeedbackMessage</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage) && Model.IsCorrect != null && !Model.ShowHint && !Model.ShowSolution)
                        {
                            <div class="alert-box @(Model.IsCorrect == true ? "alert-success-custom" : "alert-danger-custom")">@Model.FeedbackMessage</div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 2</div>

                        @if (Model.IsCorrect == true)
                        {
                            <button type="button" class="btn-main" onclick="showStep(2)">Next</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button type="submit" name="actionType" value="checkStep1" class="btn-main" onclick="setActiveStep(1)">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary" onclick="setActiveStep(1)">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary" onclick="setActiveStep(1)">Solution</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top">
                        <h3>Step 2 · Multiple choice</h3>

                        <div class="instruction-box">Which code accesses the first item in the list scores?</div>

                        <div class="quiz-card">
                            <div class="quiz-title">Which code accesses the first item in the list scores?</div>
                            <div class="mc-grid">
                                    <label class="mc-option">
                                        <input type="radio" asp-for="ExplanationAnswer" value="A" />
                                        <span>scores[1]</span>
                                    </label>
                                    <label class="mc-option">
                                        <input type="radio" asp-for="ExplanationAnswer" value="B" />
                                        <span>scores(first)</span>
                                    </label>
                                    <label class="mc-option">
                                        <input type="radio" asp-for="ExplanationAnswer" value="C" />
                                        <span>scores[0]</span>
                                    </label>
                                    <label class="mc-option">
                                        <input type="radio" asp-for="ExplanationAnswer" value="D" />
                                        <span>scores{{0}}</span>
                                    </label>
                            </div>
                        </div>

                        @if (Model.ShowHint && (ViewBag.ActiveStep ?? 0) == 2)
                        {
                            <div class="alert-box alert-info-custom">@Model.ExplanationFeedback</div>
                        }

                        @if (Model.ShowSolution && (ViewBag.ActiveStep ?? 0) == 2)
                        {
                            <div class="alert-box alert-info-custom">@Model.ExplanationFeedback</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ExplanationFeedback) && Model.ExplanationCorrect != null && !Model.ShowHint && !Model.ShowSolution)
                        {
                            <div class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")">@Model.ExplanationFeedback</div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)">Back</button>
                        <div class="step-progress">Step 2 of 2</div>

                        @if (Model.IsCorrect == true && Model.ExplanationCorrect == true)
                        {
                            <button type="submit" name="actionType" value="submit" class="btn-main" onclick="setActiveStep(2)">Mark As Completed</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button type="submit" name="actionType" value="checkStep2" class="btn-main" onclick="setActiveStep(2)">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary" onclick="setActiveStep(2)">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary" onclick="setActiveStep(2)">Solution</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Back to Lessons</a>
            <a asp-controller="UnitFive" asp-action="Looping" class="btn-main">Next Lesson</a>
        </div>
    </div>
</div>

<script>
    function setActiveStep(stepNumber) {
        document.getElementById('activeStepInput').value = stepNumber;
    }

    function showStep(stepNumber) {
        setActiveStep(stepNumber);
        document.querySelectorAll('.step-card').forEach(card => card.classList.remove('active'));
        const target = document.getElementById(`step${stepNumber}`);
        if (target) target.classList.add('active');
    }

    document.addEventListener('DOMContentLoaded', function () {
        const stepFromServer = parseInt('@(ViewBag.ActiveStep ?? 0)');
        const step1Done = '@(Model.IsCorrect?.ToString() ?? "")' === 'True';
        const step2Done = '@(Model.ExplanationCorrect?.ToString() ?? "")' === 'True';

        let stepToShow = 0;

        if (stepFromServer > 0) {
            stepToShow = stepFromServer;
        } else if (step2Done) {
            stepToShow = 2;
        } else if (step1Done) {
            stepToShow = 2;
        }

        showStep(stepToShow);
    });
</script>
