@model DotNetCoreSqlDb.ViewModels.SearchingViewModel

@{
    ViewData["Title"] = "Searching a List";
}

<style>
    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; }
    .lesson-page { min-height: 100vh; width: 100%; box-sizing: border-box; overflow: hidden; background: radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%), radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%), linear-gradient(135deg, #0b1020, #111827 50%, #0f172a); color: #e5e7eb; padding: 16px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .lesson-shell { max-width: 1100px; height: 100%; margin: 0 auto; display: flex; flex-direction: column; box-sizing: border-box; }
    .topbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
    .brand { display: flex; align-items: center; gap: 14px; }
    .brand-icon { width: 46px; height: 46px; border-radius: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(148, 163, 184, 0.18); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #f8fafc; }
    .brand-text h1 { margin: 0; font-size: 2rem; font-weight: 700; color: #ffffff; line-height: 1.1; }
    .brand-text p { margin: 4px 0 0 0; color: #94a3b8; font-size: 0.95rem; }
    .panel { background: rgba(17, 24, 39, 0.88); border: 1px solid rgba(148, 163, 184, 0.18); border-radius: 18px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28); backdrop-filter: blur(12px); }
    .step-panel { flex: 1; min-height: 0; display: flex; }
    .step-card { width: 100%; padding: 18px 20px; display: none; overflow: hidden; }
    .step-card.active { display: flex; flex-direction: column; justify-content: space-between; }
    .step-top h2, .step-top h3 { margin: 0 0 8px 0; color: #ffffff; line-height: 1.15; }
    .step-top h2 { font-size: 1.65rem; }
    .step-top h3 { font-size: 1.3rem; }
    .step-top p { margin: 0 0 10px 0; color: #94a3b8; line-height: 1.5; font-size: 0.95rem; }
    .instruction-box, .code-block { background: rgba(255,255,255,0.03); border: 1px solid rgba(148, 163, 184, 0.12); border-radius: 14px; padding: 12px 14px; color: #cbd5e1; line-height: 1.5; font-size: 0.94rem; margin-bottom: 10px; white-space: pre-wrap; }
    .quiz-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
    .quiz-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(148, 163, 184, 0.12); border-radius: 14px; padding: 12px; }
    .quiz-title { color: #ffffff; font-weight: 700; margin-bottom: 8px; font-size: 0.95rem; }
    .text-input { width: 100%; box-sizing: border-box; background: rgba(2, 6, 23, 0.7); color: #f8fafc; border: 1px solid rgba(148, 163, 184, 0.18); border-radius: 10px; padding: 10px 12px; outline: none; font-size: 0.92rem; }
    .btn-main, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; border-radius: 10px; font-weight: 600; transition: 0.2s ease; border: 1px solid rgba(255,255,255,0.08); padding: 10px 16px; cursor: pointer; }
    .btn-main { background: linear-gradient(135deg, #0ea5e9, #22c55e); color: white; }
    .btn-secondary { background: rgba(255,255,255,0.05); color: #e5e7eb; }
    .btn-main:hover, .btn-secondary:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,0.25); color: #ffffff; }
    .step-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
    .step-progress { color: #94a3b8; font-size: 0.9rem; }
    .alert-box { border-radius: 12px; padding: 10px 12px; margin-top: 10px; border: 1px solid transparent; font-size: 0.92rem; }
    .alert-success-custom { background: rgba(34, 197, 94, 0.12); color: #bbf7d0; border-color: rgba(34, 197, 94, 0.2); }
    .alert-danger-custom { background: rgba(239, 68, 68, 0.12); color: #fecaca; border-color: rgba(239, 68, 68, 0.2); }
    .alert-info-custom { background: rgba(59, 130, 246, 0.12); color: #bfdbfe; border-color: rgba(59, 130, 246, 0.2); }
    .nav-footer { margin-top: 14px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    @@media (max-width: 900px) { .step-card { padding: 16px; overflow-y: auto; } .quiz-grid { grid-template-columns: 1fr; } }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">#</div>
                <div class="brand-text">
                    <h1>CodeQuest</h1>
                    <p>Unit 5 · Searching a List</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form asp-action="Searching" asp-controller="UnitFive" method="post">
            @Html.AntiForgeryToken()

            <div class="panel step-panel">
                <div class="step-card active" id="step0">
                    <div class="step-top">
                        <h2>Searching a List</h2>
                        <p>Searching means checking items in a list until you find the value you want.</p>

                        <div class="code-block">scores = [85, 90, 78, 92]
target = 78</div>

                        <div class="instruction-box">
                            In this lesson, explain how searching works and what tools you use to search through a list.
                        </div>
                    </div>

                    <div class="step-actions">
                        <div class="step-progress">Instructions</div>
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Assignment · How do you search a list?</h3>

                        <div class="instruction-box">
                            What should you use to search through a list for a value?
                        </div>

                        <div class="quiz-grid">
                            <div class="quiz-card">
                                <div class="quiz-title">Write your answer</div>
                                <input asp-for="UserAnswer" class="text-input" placeholder="Type your answer..." />

                                @if (Model.ShowHint)
                                {
                                    <div class="alert-box alert-info-custom">
                                        Hint: you need a loop and a condition to compare each item.
                                    </div>
                                }

                                @if (Model.ShowSolution)
                                {
                                    <div class="alert-box alert-info-custom">
                                        Solution: use a loop with an IF statement to compare each item.
                                    </div>
                                }

                                @if (Model.IsCorrect != null)
                                {
                                    <div class="alert-box @(Model.IsCorrect == true ? "alert-success-custom" : "alert-danger-custom")">
                                        @Model.FeedbackMessage
                                    </div>
                                }
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">What to remember</div>
                                <p>Searching usually checks each item one by one until it finds the target value.</p>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 2</div>

                        @if (Model.IsCorrect == true)
                        {
                            <button type="button" class="btn-main" onclick="showStep(2)">Next</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px;">
                                <button type="submit" name="actionType" value="check" class="btn-main">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary">Solution</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top">
                        <h3>Reflection</h3>
                        <div class="instruction-box">
                            Explain how searching works in a list.
                        </div>

                        <input asp-for="ExplanationAnswer" class="text-input" placeholder="Example: Searching checks each item one by one until it finds the target." />

                        @if (!string.IsNullOrWhiteSpace(Model.ExplanationFeedback))
                        {
                            <div class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")">
                                @Model.ExplanationFeedback
                            </div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)">Back</button>
                        <div class="step-progress">Step 2 of 2</div>

                        @if (Model.ExplanationCorrect == true)
                        {
                            <button type="submit" name="actionType" value="submit" class="btn-main">Mark As Complete</button>
                        }
                        else
                        {
                            <button type="submit" name="actionType" value="checkExplanation" class="btn-main">Check</button>
                        }
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="UnitFive" asp-action="Looping" class="btn-secondary">Previous Lesson</a>
            <a asp-controller="Lessons" asp-action="Index" class="btn-main">Back to Lessons</a>
        </div>
    </div>
</div>

<script>
    function showStep(stepNumber) {
        document.querySelectorAll('.step-card').forEach(card => {
            card.classList.remove('active');
        });

        const target = document.getElementById(`step${stepNumber}`);
        if (target) {
            target.classList.add('active');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        let stepToShow = 0;

        const answered = '@(Model.IsCorrect?.ToString() ?? "")';
        const explanationDone = '@(Model.ExplanationCorrect?.ToString() ?? "")';

        if (explanationDone === 'True') {
            stepToShow = 2;
        } else if (answered || @((Model.ShowHint || Model.ShowSolution).ToString().ToLower())) {
            stepToShow = 1;
        }

        showStep(stepToShow);
    });
</script>