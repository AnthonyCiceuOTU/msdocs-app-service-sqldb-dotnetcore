@model DotNetCoreSqlDb.ViewModels.VariablesViewModel

@{
    ViewData["Title"] = "Variables";
    var explanationAlreadyCorrect = Model.ExplanationCorrect == true;
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .lesson-page {
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: 16px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lesson-shell {
        max-width: 1100px;
        height: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #f8fafc;
    }

    .brand-text h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.1;
    }

    .brand-text p {
        margin: 4px 0 0 0;
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .step-panel {
        flex: 1;
        min-height: 0;
        display: flex;
    }

    .step-card {
        width: 100%;
        padding: 18px 20px;
        display: none;
        overflow: hidden;
    }

    .step-card.active {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .step-top h2,
    .step-top h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        line-height: 1.15;
    }

    .step-top h2 {
        font-size: 1.65rem;
    }

    .step-top h3 {
        font-size: 1.3rem;
    }

    .step-top p {
        margin: 0 0 10px 0;
        color: #94a3b8;
        line-height: 1.5;
        font-size: 0.95rem;
    }

    .instruction-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px 14px;
        color: #cbd5e1;
        line-height: 1.5;
        font-size: 0.94rem;
        margin-bottom: 10px;
    }

    .code-block {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
        font-family: Consolas, Monaco, monospace;
        white-space: pre-wrap;
        line-height: 1.45;
        font-size: 0.92rem;
        margin-bottom: 10px;
    }

    .quiz-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        align-items: start;
    }

    .quiz-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 12px;
    }

    .quiz-title {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .mini-code {
        background: rgba(2, 6, 23, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 10px;
        padding: 10px 12px;
        color: #e2e8f0;
        font-family: Consolas, Monaco, monospace;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        background: rgba(2, 6, 23, 0.7);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        font-size: 0.92rem;
    }

    .text-input:focus {
        border-color: rgba(34, 197, 94, 0.5);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
    }

    .concept-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 8px;
    }

    .concept-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 12px;
    }

    .concept-card h4 {
        margin: 0 0 6px 0;
        color: #ffffff;
        font-size: 0.95rem;
    }

    .concept-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .btn-main,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 16px;
        cursor: pointer;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .btn-main:hover,
    .btn-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        color: #ffffff;
    }

    .btn-main:disabled,
    .btn-secondary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .step-progress {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .alert-box {
        border-radius: 12px;
        padding: 10px 12px;
        margin-top: 10px;
        border: 1px solid transparent;
        font-size: 0.92rem;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .alert-info-custom {
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .loading-box {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border: 1px solid rgba(59, 130, 246, 0.2);
        font-size: 0.92rem;
    }

    .loading-box.active {
        display: inline-flex;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(191, 219, 254, 0.25);
        border-top-color: #bfdbfe;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex: 0 0 auto;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .nav-footer {
        margin-top: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    @@media (max-width: 900px) {
        .brand-text h1 {
            font-size: 1.7rem;
        }

        .step-top h2 {
            font-size: 1.4rem;
        }

        .step-top h3 {
            font-size: 1.15rem;
        }

        .step-card {
            padding: 16px;
            overflow-y: auto;
        }

        .quiz-grid,
        .concept-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                    <p>Unit 2 · Variables</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form asp-action="Variables" asp-controller="UnitTwo" method="post" id="lessonForm">
            @Html.AntiForgeryToken()
            <input asp-for="CurrentStep" type="hidden" id="CurrentStep" />
            <input asp-for="ExplanationCorrect" type="hidden" id="ExplanationCorrectHidden" />
            <input asp-for="ExplanationFeedback" type="hidden" id="ExplanationFeedbackHidden" />

            <div class="panel step-panel">
                <div class="step-card" id="step0">
                    <div class="step-top">
                        <h2>Variables</h2>
                        <p>A variable is a named place where a program stores a value so it can use it later.</p>

                        <div class="code-block">
score ← 10
name ← "Sam"
DISPLAY score
                        </div>

                        <div class="instruction-box">
                            Variables help programs remember information. A value can be a number, text, or another kind of data.
                        </div>

                        <div class="concept-grid">
                            <div class="concept-card">
                                <h4>Store Values</h4>
                                <p>A variable keeps a value so the program can use it again later.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Use a Name</h4>
                                <p>Variables have names like <code>score</code>, <code>age</code>, or <code>name</code>.</p>
                            </div>
                            <div class="concept-card">
                                <h4>Change Over Time</h4>
                                <p>The value inside a variable can be updated as the program runs.</p>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <div class="step-progress">Instructions</div>
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Assignment · Set a Variable</h3>

                        <div class="instruction-box">
                            Complete the missing part so the variable <code>points</code> stores the value <code>25</code>.
                        </div>

                        <div class="quiz-grid">
                            <div class="quiz-card">
                                <div class="quiz-title">Fill in the missing value</div>

                                <div class="mini-code">
BEGIN
SET points = ___
DISPLAY points
END
                                </div>

                                <input asp-for="UserAnswer" class="text-input" placeholder="Type the missing value..." />

                                @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage) && Model.CurrentStep == 1)
                                {
                                    var feedbackClass = "alert-info-custom";

                                    if (Model.ShowHint || Model.ShowSolution)
                                    {
                                        feedbackClass = "alert-info-custom";
                                    }
                                    else if (Model.IsCorrect == true)
                                    {
                                        feedbackClass = "alert-success-custom";
                                    }
                                    else if (Model.IsCorrect == false)
                                    {
                                        feedbackClass = "alert-danger-custom";
                                    }

                                    <div class="alert-box @feedbackClass">
                                        @Model.FeedbackMessage
                                    </div>
                                }
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">What to remember</div>
                                <p>When you assign a value to a variable, you are telling the program what that variable should store.</p>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 2</div>

                        @if (Model.IsCorrect == true && Model.CurrentStep == 1)
                        {
                            <button type="button" class="btn-main" onclick="showStep(2)">Next</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button type="submit" name="actionType" value="check" class="btn-main">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary">Solution</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top">
                        <h3>Reflection</h3>

                        <div class="instruction-box">
                            In one short sentence, explain what a variable is used for in a program.
                        </div>

                        <div class="quiz-grid">
                            <div class="quiz-card">
                                <div class="quiz-title">Your explanation</div>
                                <input asp-for="ExplanationAnswer"
                                       id="ExplanationAnswer"
                                       class="text-input"
                                       placeholder="Example: A variable stores a value so the program can use it later." />
                            </div>

                            <div class="quiz-card">
                                <div class="quiz-title">AI feedback</div>
                                <textarea id="aiFeedbackDisplay"
                                          class="text-input"
                                          rows="4"
                                          readonly
                                          placeholder="AI feedback will appear here...">@Model.ExplanationFeedback</textarea>
                            </div>
                        </div>

                        <div id="aiLoadingBox" class="loading-box">
                            <div class="spinner"></div>
                            <span>Checking with AI...</span>
                        </div>

                        <div id="aiFeedbackAlert"
                             class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")"
                             style="@(string.IsNullOrWhiteSpace(Model.ExplanationFeedback) ? "display:none;" : "")">
                            @Model.ExplanationFeedback
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage) && Model.CurrentStep == 2 && Model.ExplanationCorrect == true)
                        {
                            <div class="alert-box @(Model.FeedbackMessage.Contains("could not be saved") ? "alert-danger-custom" : "alert-success-custom")">
                                @Model.FeedbackMessage
                            </div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)" id="backToStep1Button">Back</button>
                        <div class="step-progress">Step 2 of 2</div>

                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button type="button"
                                    class="btn-main"
                                    id="checkExplanationButton"
                                    @(explanationAlreadyCorrect ? "disabled" : "")>
                                @(explanationAlreadyCorrect ? "Checked" : "Check with AI")
                            </button>

                            <button type="submit"
                                    name="actionType"
                                    value="submit"
                                    class="btn-main"
                                    id="submitLessonButton"
                                    style="@(Model.ExplanationCorrect == true ? "" : "display:none;")">
                                Mark Lesson as Completed
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Back to Lessons</a>
            <a asp-controller="UnitTwo" asp-action="DataTypes" class="btn-main">Next Lesson</a>
        </div>
    </div>
</div>

<script>
    function showStep(stepNumber) {
        document.querySelectorAll('.step-card').forEach(card => {
            card.classList.remove('active');
        });

        const target = document.getElementById(`step${stepNumber}`);
        if (target) {
            target.classList.add('active');
        }

        const hiddenStep = document.getElementById('CurrentStep');
        if (hiddenStep) {
            hiddenStep.value = stepNumber;
        }
    }

    function markExplanationCheckedState(isChecked) {
        const checkButton = document.getElementById('checkExplanationButton');

        if (!checkButton) return;

        checkButton.disabled = isChecked;
        checkButton.textContent = isChecked ? 'Checked' : 'Check with AI';
    }

    function setStepTwoLoadingState(isLoading) {
        const loadingBox = document.getElementById('aiLoadingBox');
        const checkButton = document.getElementById('checkExplanationButton');
        const backButton = document.getElementById('backToStep1Button');
        const explanationInput = document.getElementById('ExplanationAnswer');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');

        const alreadyChecked = explanationCorrectHidden && explanationCorrectHidden.value === 'true';

        if (loadingBox) {
            loadingBox.classList.toggle('active', isLoading);
        }

        if (checkButton) {
            if (isLoading) {
                checkButton.disabled = true;
                checkButton.textContent = 'Checking...';
            } else {
                markExplanationCheckedState(alreadyChecked);
            }
        }

        if (backButton) {
            backButton.disabled = isLoading;
        }

        if (explanationInput) {
            explanationInput.readOnly = isLoading;
        }
    }

    function setAiResult(isCorrect, feedback) {
        const feedbackDisplay = document.getElementById('aiFeedbackDisplay');
        const feedbackAlert = document.getElementById('aiFeedbackAlert');
        const submitLessonButton = document.getElementById('submitLessonButton');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
        const explanationFeedbackHidden = document.getElementById('ExplanationFeedbackHidden');

        if (feedbackDisplay) {
            feedbackDisplay.value = feedback || '';
        }

        if (feedbackAlert) {
            feedbackAlert.style.display = 'block';
            feedbackAlert.textContent = feedback || '';
            feedbackAlert.classList.remove('alert-success-custom', 'alert-danger-custom');
            feedbackAlert.classList.add(isCorrect ? 'alert-success-custom' : 'alert-danger-custom');
        }

        if (explanationCorrectHidden) {
            explanationCorrectHidden.value = isCorrect ? 'true' : 'false';
        }

        if (explanationFeedbackHidden) {
            explanationFeedbackHidden.value = feedback || '';
        }

        if (submitLessonButton) {
            submitLessonButton.style.display = isCorrect ? '' : 'none';
        }

        markExplanationCheckedState(isCorrect);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const currentStep = parseInt(document.getElementById('CurrentStep')?.value || '0');
        showStep(currentStep);

        markExplanationCheckedState(@(Model.ExplanationCorrect == true ? "true" : "false"));

        const checkExplanationButton = document.getElementById('checkExplanationButton');

        if (checkExplanationButton) {
            checkExplanationButton.addEventListener('click', async function () {
                const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
                if (explanationCorrectHidden && explanationCorrectHidden.value === 'true') {
                    markExplanationCheckedState(true);
                    return;
                }

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const explanationAnswer = document.getElementById('ExplanationAnswer')?.value ?? '';

                setStepTwoLoadingState(true);

                try {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
                    formData.append('explanationAnswer', explanationAnswer);

                    const response = await fetch('@Url.Action("CheckVariablesExplanation", "UnitTwo")', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        setAiResult(false, data.feedback || 'We could not check your explanation right now.');
                        return;
                    }

                    setAiResult(data.isCorrect, data.feedback);
                } catch (error) {
                    setAiResult(false, 'We could not check your explanation right now. Please try again.');
                } finally {
                    setStepTwoLoadingState(false);
                }
            });
        }
    });
</script>