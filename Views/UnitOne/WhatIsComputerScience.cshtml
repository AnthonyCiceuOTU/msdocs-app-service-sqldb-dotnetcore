@model DotNetCoreSqlDb.ViewModels.ComputerScienceViewModel

@{
    ViewData["Title"] = "What Is Computer Science?";
    var explanationAlreadyCorrect = Model.ExplanationCorrect == true;
}

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .lesson-page {
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: 14px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lesson-shell {
        max-width: 1100px;
        height: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        min-height: 0;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        color: #f8fafc;
    }

    .brand-text h1 {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.05;
    }

    .brand-text p {
        margin: 4px 0 0 0;
        color: #94a3b8;
        font-size: 0.92rem;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .step-panel {
        flex: 1;
        min-height: 0;
        display: flex;
        overflow: hidden;
    }

    .step-card {
        width: 100%;
        padding: 16px 18px;
        display: none;
        overflow: hidden;
        min-height: 0;
    }

    .step-card.active {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 0;
        gap: 10px;
    }

    .step-top {
        min-height: 0;
    }

    .step-top h2,
    .step-top h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        line-height: 1.12;
    }

    .step-top h2 {
        font-size: 1.5rem;
    }

    .step-top h3 {
        font-size: 1.2rem;
    }

    .step-top p {
        margin: 0 0 10px 0;
        color: #94a3b8;
        line-height: 1.45;
        font-size: 0.93rem;
    }

    .instruction-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 10px 12px;
        color: #cbd5e1;
        line-height: 1.45;
        font-size: 0.92rem;
        margin-bottom: 10px;
    }

    .code-block {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 11px 13px;
        font-family: Consolas, Monaco, monospace;
        white-space: pre-wrap;
        line-height: 1.4;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    .drag-hint {
        color: #94a3b8;
        font-size: 0.88rem;
        margin-bottom: 10px;
    }

    .sortable-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 8px;
    }

    .sortable-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.14);
        border-radius: 12px;
        padding: 9px 11px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: grab;
        user-select: none;
    }

    .sortable-item:active {
        cursor: grabbing;
    }

    .sortable-item.dragging {
        opacity: 0.55;
        border-color: rgba(34, 197, 94, 0.45);
    }

    .step-number {
        width: 28px;
        height: 28px;
        flex: 0 0 28px;
        border-radius: 9px;
        background: rgba(14, 165, 233, 0.15);
        color: #bae6fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.88rem;
    }

    .step-text {
        flex: 1;
        color: #e5e7eb;
        font-weight: 500;
        font-size: 0.93rem;
        line-height: 1.3;
    }

    .mc-grid {
        display: grid;
        gap: 10px;
    }

    .mc-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .mc-header {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 8px;
    }

    .mc-header label {
        color: #e5e7eb;
        font-size: 0.93rem;
        line-height: 1.35;
        flex: 1;
    }

    .mc-header input[type="checkbox"] {
        transform: scale(1.05);
        margin-top: 3px;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        background: rgba(2, 6, 23, 0.7);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 9px 11px;
        outline: none;
        font-size: 0.9rem;
    }

    .text-input:focus {
        border-color: rgba(34, 197, 94, 0.5);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
    }

    textarea.text-input {
        resize: none;
    }

    .btn-main,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 9px 15px;
        cursor: pointer;
        font-size: 0.92rem;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .btn-main:hover,
    .btn-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        color: #ffffff;
    }

    .btn-main:disabled,
    .btn-secondary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 6px;
        flex: 0 0 auto;
    }

    .step-progress {
        color: #94a3b8;
        font-size: 0.88rem;
    }

    .alert-box {
        border-radius: 12px;
        padding: 9px 11px;
        margin-top: 10px;
        border: 1px solid transparent;
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .alert-info-custom {
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .loading-box {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
        padding: 9px 11px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border: 1px solid rgba(59, 130, 246, 0.2);
        font-size: 0.9rem;
    }

    .loading-box.active {
        display: inline-flex;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(191, 219, 254, 0.25);
        border-top-color: #bfdbfe;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex: 0 0 auto;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .nav-footer {
        margin-top: 12px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    .question3-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.85fr);
        gap: 12px;
        min-height: 0;
        align-items: start;
    }

    .question3-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        align-content: start;
    }

    .question3-options .mc-card {
        min-height: 0;
    }

    .question3-side {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
    }

    .feedback-panel-title {
        margin: 0 0 8px 0;
        color: #ffffff;
        font-size: 0.98rem;
        font-weight: 700;
    }

    .feedback-textarea {
        min-height: 160px;
    }

    .step3-card .step-top {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .step3-main {
        min-height: 0;
        overflow: hidden;
    }

    @@media (max-width: 1200px) {
        .lesson-page {
            padding: 12px;
        }

        .brand-text h1 {
            font-size: 1.65rem;
        }

        .step-top h2 {
            font-size: 1.35rem;
        }

        .step-top h3 {
            font-size: 1.12rem;
        }

        .question3-layout {
            grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
            gap: 10px;
        }

        .question3-options {
            gap: 8px;
        }

        .mc-card {
            padding: 9px 10px;
        }

        .text-input {
            padding: 8px 10px;
            font-size: 0.88rem;
        }

        .feedback-textarea {
            min-height: 140px;
        }
    }

    @@media (max-width: 900px) {
        .brand-text h1 {
            font-size: 1.55rem;
        }

        .step-card {
            padding: 14px;
            overflow-y: auto;
        }

        .question3-layout {
            grid-template-columns: 1fr;
        }

        .question3-options {
            grid-template-columns: 1fr;
        }

        .feedback-textarea {
            min-height: 120px;
        }
    }

    @@media (max-height: 860px) and (min-width: 901px) {
        .lesson-page {
            padding: 10px;
        }

        .topbar {
            margin-bottom: 10px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            font-size: 16px;
        }

        .brand-text h1 {
            font-size: 1.5rem;
        }

        .brand-text p {
            font-size: 0.88rem;
        }

        .step-card {
            padding: 14px 16px;
        }

        .step-top h2 {
            font-size: 1.28rem;
        }

        .step-top h3 {
            font-size: 1.08rem;
        }

        .instruction-box,
        .code-block,
        .alert-box,
        .loading-box {
            margin-top: 8px;
            margin-bottom: 8px;
        }

        .question3-options {
            gap: 8px;
        }

        .mc-card {
            padding: 8px 10px;
        }

        .feedback-textarea {
            min-height: 110px;
        }

        .nav-footer {
            margin-top: 10px;
        }
    }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                    <p>Unit 1 · Lesson 1</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form id="lessonForm" asp-action="WhatIsComputerScience" asp-controller="UnitOne" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="PbSandwichOrder" type="hidden" id="PbSandwichOrder" />
            <input asp-for="CardSortOrder" type="hidden" id="CardSortOrder" />
            <input asp-for="ExplanationCorrect" type="hidden" id="ExplanationCorrectHidden" />
            <input asp-for="ExplanationFeedback" type="hidden" id="ExplanationFeedbackHidden" />

            <div class="panel step-panel">
                <div class="step-card active" id="step0">
                    <div class="step-top">
                        <h2>What Is Computer Science?</h2>
                        <p>
                            Computer science is about solving problems using clear, logical instructions.
                            In this lesson, you will practice recognizing and ordering algorithms.
                        </p>

                        <div class="code-block">BEGIN
DISPLAY "Step 1: Get bread"
DISPLAY "Step 2: Add filling"
DISPLAY "Step 3: Close sandwich"
END</div>

                        <div class="instruction-box">
                            Complete the lesson in order: first read the instructions, then arrange sandwich
                            steps, then arrange card-sorting steps, then identify which examples are algorithms.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
                        {
                            var overallClass = Model.IsCorrect == true
                                ? "alert-success-custom"
                                : Model.IsCorrect == false
                                    ? "alert-danger-custom"
                                    : "alert-info-custom";

                            <div class="alert-box @overallClass">
                                @Model.FeedbackMessage
                            </div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Question 1 · PB sandwich</h3>
                        <div class="instruction-box">
                            Drag the steps into the correct order.
                        </div>
                        <div class="drag-hint">Drag and drop each card.</div>

                        <ul class="sortable-list" id="pbList">
                            @{
                                var pbSteps = (string.IsNullOrWhiteSpace(Model.PbSandwichOrder)
                                    ? "Put bread slices on plate|Spread jam on one slice|Spread peanut butter on the other slice|Press the slices together"
                                    : Model.PbSandwichOrder).Split('|');
                            }

                            @for (int i = 0; i < pbSteps.Length; i++)
                            {
                                <li class="sortable-item" draggable="true" data-value="@pbSteps[i]">
                                    <div class="step-number">@(i + 1)</div>
                                    <div class="step-text">@pbSteps[i]</div>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(Model.PbFeedback))
                        {
                            var pbClass = Model.PbCorrect == true ? "alert-success-custom" : "alert-danger-custom";
                            <div class="alert-box @pbClass">@Model.PbFeedback</div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 3</div>

                        @if (Model.PbCorrect == true)
                        {
                            <button type="submit" name="actionType" value="goStep2" class="btn-main">Next</button>
                        }
                        else
                        {
                            <button type="submit" name="actionType" value="checkPb" class="btn-main">Check</button>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top">
                        <h3>Question 2 · Sort a deck of cards</h3>
                        <div class="instruction-box">
                            Drag the steps into the best order for a simple sorting process.
                        </div>
                        <div class="drag-hint">Drag and drop each card.</div>

                        <ul class="sortable-list" id="cardList">
                            @{
                                var cardSteps = (string.IsNullOrWhiteSpace(Model.CardSortOrder)
                                    ? "Shuffle the deck|Look at the first two cards|Compare their values|Swap them if needed|Repeat until the deck is in order|Stop when no swaps are needed"
                                    : Model.CardSortOrder).Split('|');
                            }

                            @for (int i = 0; i < cardSteps.Length; i++)
                            {
                                <li class="sortable-item" draggable="true" data-value="@cardSteps[i]">
                                    <div class="step-number">@(i + 1)</div>
                                    <div class="step-text">@cardSteps[i]</div>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(Model.CardFeedback))
                        {
                            var cardClass = Model.CardCorrect == true ? "alert-success-custom" : "alert-danger-custom";
                            <div class="alert-box @cardClass">@Model.CardFeedback</div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)">Back</button>
                        <div class="step-progress">Step 2 of 3</div>

                        @if (Model.CardCorrect == true)
                        {
                            <button type="submit" name="actionType" value="goStep3" class="btn-main">Next</button>
                        }
                        else
                        {
                            <button type="submit" name="actionType" value="checkCards" class="btn-main">Check</button>
                        }
                    </div>
                </div>

                <div class="step-card step3-card" id="step3">
                    <div class="step-top">
                        <h3>Question 3 · Identify algorithms</h3>

                        <div class="instruction-box">
                            Select the items that are algorithms and briefly explain why or why not.
                            Then use AI to check your explanations before submitting the lesson.
                        </div>

                        <div class="step3-main">
                            <div class="question3-layout">
                                <div class="question3-options">
                                    <div class="mc-card">
                                        <div class="mc-header">
                                            <input asp-for="RecipeSelected" type="checkbox" id="RecipeSelected" />
                                            <label asp-for="RecipeSelected"><strong>A. A recipe for pancakes</strong></label>
                                        </div>
                                        <input asp-for="RecipeExplanation"
                                               id="RecipeExplanation"
                                               class="text-input"
                                               placeholder="Why is this or is this not an algorithm?" />
                                    </div>

                                    <div class="mc-card">
                                        <div class="mc-header">
                                            <input asp-for="GroceryListSelected" type="checkbox" id="GroceryListSelected" />
                                            <label asp-for="GroceryListSelected"><strong>B. A list of groceries</strong></label>
                                        </div>
                                        <input asp-for="GroceryListExplanation"
                                               id="GroceryListExplanation"
                                               class="text-input"
                                               placeholder="Why is this or is this not an algorithm?" />
                                    </div>

                                    <div class="mc-card">
                                        <div class="mc-header">
                                            <input asp-for="GpsSelected" type="checkbox" id="GpsSelected" />
                                            <label asp-for="GpsSelected"><strong>C. GPS directions to a destination</strong></label>
                                        </div>
                                        <input asp-for="GpsExplanation"
                                               id="GpsExplanation"
                                               class="text-input"
                                               placeholder="Why is this or is this not an algorithm?" />
                                    </div>

                                    <div class="mc-card">
                                        <div class="mc-header">
                                            <input asp-for="PhotoSelected" type="checkbox" id="PhotoSelected" />
                                            <label asp-for="PhotoSelected"><strong>D. A photo</strong></label>
                                        </div>
                                        <input asp-for="PhotoExplanation"
                                               id="PhotoExplanation"
                                               class="text-input"
                                               placeholder="Why is this or is this not an algorithm?" />
                                    </div>
                                </div>

                                <div class="question3-side">
                                    <div class="mc-card">
                                        <div class="feedback-panel-title">AI feedback</div>
                                        <textarea id="aiFeedbackDisplay"
                                                  class="text-input feedback-textarea"
                                                  readonly
                                                  placeholder="AI feedback will appear here...">@Model.ExplanationFeedback</textarea>
                                    </div>

                                    <div id="aiLoadingBox" class="loading-box">
                                        <div class="spinner"></div>
                                        <span>Checking with AI...</span>
                                    </div>

                                    <div id="aiFeedbackAlert"
                                         class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")"
                                         style="@(string.IsNullOrWhiteSpace(Model.ExplanationFeedback) ? "display:none;" : "")">
                                        @Model.ExplanationFeedback
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(2)" id="backToStep2Button">Back</button>
                        <div class="step-progress">Step 3 of 3</div>

                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button type="button"
                                    class="btn-main"
                                    id="checkExplanationButton"
                                    @(explanationAlreadyCorrect ? "disabled" : "")>
                                @(explanationAlreadyCorrect ? "Checked" : "Check with AI")
                            </button>

                            <button type="submit"
                                    name="actionType"
                                    value="submit"
                                    class="btn-main"
                                    id="submitLessonButton"
                                    style="@(Model.ExplanationCorrect == true ? "" : "display:none;")">
                                Submit Lesson
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="Home" asp-action="Index" class="btn-secondary">Back Home</a>
            <a asp-controller="UnitOne" asp-action="Algorithms" class="btn-main">Go to Unit 1, Lesson 2</a>
        </div>
    </div>
</div>

<script>
    function updateStepNumbers(listId) {
        const items = document.querySelectorAll(`#${listId} .sortable-item`);
        items.forEach((item, index) => {
            const number = item.querySelector('.step-number');
            if (number) {
                number.textContent = index + 1;
            }
        });
    }

    function saveOrder(listId, hiddenInputId) {
        const items = document.querySelectorAll(`#${listId} .sortable-item`);
        const values = Array.from(items).map(x => x.getAttribute('data-value'));
        const hiddenInput = document.getElementById(hiddenInputId);

        if (hiddenInput) {
            hiddenInput.value = values.join('|');
        }

        updateStepNumbers(listId);
    }

    function showStep(stepNumber) {
        document.querySelectorAll('.step-card').forEach(card => {
            card.classList.remove('active');
        });

        const target = document.getElementById(`step${stepNumber}`);
        if (target) {
            target.classList.add('active');
        }

        saveOrder('pbList', 'PbSandwichOrder');
        saveOrder('cardList', 'CardSortOrder');
    }

    function enableDragSort(listId, hiddenInputId) {
        const list = document.getElementById(listId);
        if (!list) return;

        let draggedItem = null;

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.sortable-item:not(.dragging)')];

            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;

                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        list.querySelectorAll('.sortable-item').forEach(item => {
            item.addEventListener('dragstart', () => {
                draggedItem = item;
                item.classList.add('dragging');
            });

            item.addEventListener('dragend', () => {
                item.classList.remove('dragging');
                draggedItem = null;
                saveOrder(listId, hiddenInputId);
            });
        });

        list.addEventListener('dragover', e => {
            e.preventDefault();
            const afterElement = getDragAfterElement(list, e.clientY);
            const currentDragged = list.querySelector('.dragging');

            if (!currentDragged) return;

            if (afterElement == null) {
                list.appendChild(currentDragged);
            } else {
                list.insertBefore(currentDragged, afterElement);
            }
        });

        saveOrder(listId, hiddenInputId);
    }

    function markExplanationCheckedState(isChecked) {
        const checkButton = document.getElementById('checkExplanationButton');

        if (!checkButton) return;

        checkButton.disabled = isChecked;
        checkButton.textContent = isChecked ? 'Checked' : 'Check with AI';
    }

    function setStepThreeLoadingState(isLoading) {
        const loadingBox = document.getElementById('aiLoadingBox');
        const checkButton = document.getElementById('checkExplanationButton');
        const backButton = document.getElementById('backToStep2Button');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');

        const alreadyChecked = explanationCorrectHidden && explanationCorrectHidden.value === 'true';

        const inputs = [
            document.getElementById('RecipeExplanation'),
            document.getElementById('GroceryListExplanation'),
            document.getElementById('GpsExplanation'),
            document.getElementById('PhotoExplanation')
        ];

        if (loadingBox) {
            loadingBox.classList.toggle('active', isLoading);
        }

        if (checkButton) {
            if (isLoading) {
                checkButton.disabled = true;
                checkButton.textContent = 'Checking...';
            } else {
                markExplanationCheckedState(alreadyChecked);
            }
        }

        if (backButton) {
            backButton.disabled = isLoading;
        }

        inputs.forEach(input => {
            if (input) {
                input.readOnly = isLoading;
            }
        });
    }

    function setAiResult(isCorrect, feedback) {
        const feedbackDisplay = document.getElementById('aiFeedbackDisplay');
        const feedbackAlert = document.getElementById('aiFeedbackAlert');
        const submitLessonButton = document.getElementById('submitLessonButton');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
        const explanationFeedbackHidden = document.getElementById('ExplanationFeedbackHidden');

        if (feedbackDisplay) {
            feedbackDisplay.value = feedback || '';
        }

        if (feedbackAlert) {
            feedbackAlert.style.display = 'block';
            feedbackAlert.textContent = feedback || '';
            feedbackAlert.classList.remove('alert-success-custom', 'alert-danger-custom');
            feedbackAlert.classList.add(isCorrect ? 'alert-success-custom' : 'alert-danger-custom');
        }

        if (explanationCorrectHidden) {
            explanationCorrectHidden.value = isCorrect ? 'true' : 'false';
        }

        if (explanationFeedbackHidden) {
            explanationFeedbackHidden.value = feedback || '';
        }

        if (submitLessonButton) {
            submitLessonButton.style.display = isCorrect ? '' : 'none';
        }

        markExplanationCheckedState(isCorrect);
    }

    document.addEventListener('DOMContentLoaded', function () {
        enableDragSort('pbList', 'PbSandwichOrder');
        enableDragSort('cardList', 'CardSortOrder');

        const currentStep = @Model.CurrentStep;
        showStep(currentStep);

        markExplanationCheckedState(@(Model.ExplanationCorrect == true ? "true" : "false"));

        const checkExplanationButton = document.getElementById('checkExplanationButton');

        if (checkExplanationButton) {
            checkExplanationButton.addEventListener('click', async function () {
                const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
                if (explanationCorrectHidden && explanationCorrectHidden.value === 'true') {
                    markExplanationCheckedState(true);
                    return;
                }

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

                const recipeSelected = document.getElementById('RecipeSelected')?.checked ?? false;
                const groceryListSelected = document.getElementById('GroceryListSelected')?.checked ?? false;
                const gpsSelected = document.getElementById('GpsSelected')?.checked ?? false;
                const photoSelected = document.getElementById('PhotoSelected')?.checked ?? false;

                const recipeExplanation = document.getElementById('RecipeExplanation')?.value ?? '';
                const groceryListExplanation = document.getElementById('GroceryListExplanation')?.value ?? '';
                const gpsExplanation = document.getElementById('GpsExplanation')?.value ?? '';
                const photoExplanation = document.getElementById('PhotoExplanation')?.value ?? '';

                setStepThreeLoadingState(true);

                try {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
                    formData.append('recipeSelected', recipeSelected);
                    formData.append('groceryListSelected', groceryListSelected);
                    formData.append('gpsSelected', gpsSelected);
                    formData.append('photoSelected', photoSelected);
                    formData.append('recipeExplanation', recipeExplanation);
                    formData.append('groceryListExplanation', groceryListExplanation);
                    formData.append('gpsExplanation', gpsExplanation);
                    formData.append('photoExplanation', photoExplanation);

                    const response = await fetch('@Url.Action("CheckWhatIsComputerScienceExplanation", "UnitOne")', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        setAiResult(false, data.feedback || 'We could not check your explanations right now.');
                        return;
                    }

                    setAiResult(data.isCorrect, data.feedback);
                } catch (error) {
                    setAiResult(false, 'We could not check your explanations right now. Please try again.');
                } finally {
                    setStepThreeLoadingState(false);
                }
            });
        }
    });
</script>