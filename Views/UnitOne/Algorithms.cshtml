@model DotNetCoreSqlDb.ViewModels.AlgorithmsViewModel

@{
    ViewData["Title"] = "Algorithms";
    var explanationAlreadyCorrect = Model.ExplanationCorrect == true;
}

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .lesson-page {
        height: 100vh;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(34, 197, 94, 0.08), transparent 30%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.08), transparent 30%),
            linear-gradient(135deg, #0b1020, #111827 50%, #0f172a);
        color: #e5e7eb;
        padding: 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .lesson-shell {
        max-width: 1100px;
        height: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        min-height: 0;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148, 163, 184, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        color: #f8fafc;
        flex: 0 0 auto;
    }

    .brand-text h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.05;
    }

    .brand-text p {
        margin: 3px 0 0 0;
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .panel {
        background: rgba(17, 24, 39, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(12px);
    }

    .step-panel {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        overflow: hidden;
    }

    .step-card {
        width: 100%;
        padding: 16px 18px;
        display: none;
        overflow: hidden;
        min-height: 0;
    }

    .step-card.active {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .step-top {
        min-height: 0;
    }

    .step-top h2,
    .step-top h3 {
        margin: 0 0 8px 0;
        color: #ffffff;
        line-height: 1.12;
    }

    .step-top h2 {
        font-size: 1.5rem;
    }

    .step-top h3 {
        font-size: 1.2rem;
    }

    .step-top p {
        margin: 0 0 8px 0;
        color: #94a3b8;
        line-height: 1.4;
        font-size: 0.93rem;
    }

    .instruction-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 14px;
        padding: 10px 12px;
        color: #cbd5e1;
        line-height: 1.4;
        font-size: 0.91rem;
        margin-bottom: 8px;
    }

    .code-block {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 10px 12px;
        font-family: Consolas, Monaco, monospace;
        white-space: pre-wrap;
        line-height: 1.4;
        font-size: 0.89rem;
        margin-bottom: 8px;
    }

    .compact-code {
        background: rgba(2, 6, 23, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.15);
        color: #e2e8f0;
        border-radius: 14px;
        padding: 10px 12px;
        font-family: Consolas, Monaco, monospace;
        font-size: 0.89rem;
        line-height: 1.55;
        margin-bottom: 8px;
    }

    .inline-answer {
        width: 110px;
        max-width: 110px;
        display: inline-block;
        vertical-align: middle;
        margin: 0 5px;
        background: rgba(15, 23, 42, 0.95);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 7px 9px;
        outline: none;
        font-size: 0.9rem;
    }

    .inline-answer:focus {
        border-color: rgba(34, 197, 94, 0.5);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
    }

    .mc-grid {
        display: grid;
        gap: 10px;
    }

    .mc-grid.step-two-grid {
        grid-template-columns: 1.2fr 0.8fr;
        align-items: start;
    }

    .mc-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 10px 12px;
        min-height: 0;
    }

    .mc-header {
        color: #e5e7eb;
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 0.92rem;
    }

    .text-input {
        width: 100%;
        box-sizing: border-box;
        background: rgba(2, 6, 23, 0.7);
        color: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        font-size: 0.91rem;
        resize: none;
    }

    .text-input:focus {
        border-color: rgba(34, 197, 94, 0.5);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
    }

    .btn-main,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 9px 14px;
        cursor: pointer;
        font-size: 0.92rem;
        white-space: nowrap;
    }

    .btn-main {
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        color: white;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.05);
        color: #e5e7eb;
    }

    .btn-main:hover,
    .btn-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        color: #ffffff;
    }

    .btn-main:disabled,
    .btn-secondary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 10px;
        flex: 0 0 auto;
    }

    .step-progress {
        color: #94a3b8;
        font-size: 0.88rem;
    }

    .alert-box {
        border-radius: 12px;
        padding: 9px 11px;
        margin-top: 8px;
        border: 1px solid transparent;
        font-size: 0.9rem;
        line-height: 1.35;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.12);
        color: #bbf7d0;
        border-color: rgba(34, 197, 94, 0.2);
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        color: #fecaca;
        border-color: rgba(239, 68, 68, 0.2);
    }

    .alert-info-custom {
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border-color: rgba(59, 130, 246, 0.2);
    }

    .loading-box {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        padding: 9px 11px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.12);
        color: #bfdbfe;
        border: 1px solid rgba(59, 130, 246, 0.2);
        font-size: 0.9rem;
    }

    .loading-box.active {
        display: inline-flex;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(191, 219, 254, 0.25);
        border-top-color: #bfdbfe;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex: 0 0 auto;
    }

    .step-two-layout {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 0;
    }

    .step-two-layout .text-input.explanation-box {
        min-height: 140px;
        height: 140px;
    }

    .step-two-layout .text-input.feedback-box {
        min-height: 110px;
        height: 110px;
    }

    .step-two-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .nav-footer {
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    @@media (max-width: 900px) {
        .lesson-page {
            padding: 10px;
        }

        .brand-text h1 {
            font-size: 1.55rem;
        }

        .step-top h2 {
            font-size: 1.3rem;
        }

        .step-top h3 {
            font-size: 1.08rem;
        }

        .step-card {
            padding: 14px;
        }

        .mc-grid.step-two-grid {
            grid-template-columns: 1fr;
        }

        .step-two-layout .text-input.explanation-box {
            height: 120px;
            min-height: 120px;
        }

        .step-two-layout .text-input.feedback-box {
            height: 90px;
            min-height: 90px;
        }
    }

    @@media (max-height: 860px) {
        .lesson-page {
            padding: 8px;
        }

        .topbar {
            margin-bottom: 8px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            font-size: 15px;
        }

        .brand-text h1 {
            font-size: 1.45rem;
        }

        .brand-text p {
            font-size: 0.85rem;
        }

        .step-card {
            padding: 12px 14px;
        }

        .step-top h2 {
            font-size: 1.22rem;
            margin-bottom: 6px;
        }

        .step-top h3 {
            font-size: 1.03rem;
            margin-bottom: 6px;
        }

        .step-top p,
        .instruction-box,
        .code-block,
        .compact-code,
        .alert-box,
        .loading-box,
        .step-progress,
        .mc-header,
        .text-input,
        .btn-main,
        .btn-secondary {
            font-size: 0.86rem;
        }

        .instruction-box,
        .code-block,
        .compact-code,
        .mc-card {
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .step-two-layout .text-input.explanation-box {
            height: 100px;
            min-height: 100px;
        }

        .step-two-layout .text-input.feedback-box {
            height: 76px;
            min-height: 76px;
        }

        .step-actions {
            margin-top: 8px;
        }

        .nav-footer {
            margin-top: 8px;
        }
    }
</style>

<div class="lesson-page">
    <div class="lesson-shell">
        <div class="topbar">
            <div class="brand">
                <div class="brand-icon">&lt;/&gt;</div>
                <div class="brand-text">
                    <h1>Code Quest</h1>
                    <p>Unit 1, Lesson 2 · Algorithms</p>
                </div>
            </div>

            <a asp-controller="Lessons" asp-action="Index" class="btn-secondary">Browse Lessons</a>
        </div>

        <form asp-action="Algorithms" asp-controller="UnitOne" method="post" id="lessonForm" style="display:flex; flex-direction:column; flex:1; min-height:0;">
            @Html.AntiForgeryToken()
            <input asp-for="CurrentStep" type="hidden" id="CurrentStep" />
            <input asp-for="ExplanationCorrect" type="hidden" id="ExplanationCorrectHidden" />
            <input asp-for="ExplanationFeedback" type="hidden" id="ExplanationFeedbackHidden" />

            <div class="panel step-panel">
                <div class="step-card" id="step0">
                    <div class="step-top">
                        <h2>Algorithms</h2>
                        <p>
                            An algorithm is a clear step-by-step process for solving a problem.
                            Good algorithms use the correct variables and follow a logical order.
                        </p>

                        <div class="code-block">
BEGIN
SET price1 = 5
SET price2 = 10
SET total = price1 + price2
DISPLAY total
END
                        </div>

                        <div class="instruction-box">
                            In this lesson, you will complete part of an algorithm and then explain why the fix works.
                        </div>
                    </div>

                    <div class="step-actions">
                        <div class="step-progress">Instructions</div>
                        <button type="button" class="btn-main" onclick="showStep(1)">Next</button>
                    </div>
                </div>

                <div class="step-card" id="step1">
                    <div class="step-top">
                        <h3>Question 1 · Fix the algorithm</h3>
                        <div class="instruction-box">
                            Complete the algorithm so it correctly calculates the total cost of two items.
                        </div>

                        <div class="compact-code">
                            <div>BEGIN</div>
                            <div>SET price1 = 5</div>
                            <div>SET price2 = 10</div>
                            <div>
                                SET total =
                                <input asp-for="UserAnswer1" class="inline-answer" />
                                +
                                <input asp-for="UserAnswer2" class="inline-answer" />
                            </div>
                            <div>DISPLAY total</div>
                            <div>END</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
                        {
                            var feedbackClass = "alert-info-custom";

                            if (Model.ShowHint || Model.ShowSolution)
                            {
                                feedbackClass = "alert-info-custom";
                            }
                            else if (Model.IsCorrect == true)
                            {
                                feedbackClass = "alert-success-custom";
                            }
                            else if (Model.IsCorrect == false)
                            {
                                feedbackClass = "alert-danger-custom";
                            }

                            <div class="alert-box @feedbackClass">
                                @Model.FeedbackMessage
                            </div>
                        }
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(0)">Back</button>
                        <div class="step-progress">Step 1 of 2</div>

                        @if (Model.IsCorrect == true && Model.CurrentStep == 1)
                        {
                            <button type="button" class="btn-main" onclick="showStep(2)">Next</button>
                        }
                        else
                        {
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button type="submit" name="actionType" value="check" class="btn-main">Check</button>
                                <button type="submit" name="actionType" value="hint" class="btn-secondary">Hint</button>
                                <button type="submit" name="actionType" value="solution" class="btn-secondary">Solution</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="step-card" id="step2">
                    <div class="step-top step-two-layout">
                        <div>
                            <h3>Question 2 · Explain the fix</h3>
                            <div class="instruction-box">
                                Explain why using those two variables makes the algorithm correct.
                            </div>
                        </div>

                        <div class="mc-grid step-two-grid">
                            <div class="mc-card">
                                <div class="mc-header">Your explanation</div>
                                <textarea asp-for="ExplanationAnswer"
                                          id="ExplanationAnswer"
                                          class="text-input explanation-box"
                                          placeholder="Explain why the algorithm works..."></textarea>
                            </div>

                            <div class="mc-card">
                                <div class="mc-header">AI feedback</div>
                                <textarea id="aiFeedbackDisplay"
                                          class="text-input feedback-box"
                                          readonly
                                          placeholder="AI feedback will appear here...">@Model.ExplanationFeedback</textarea>
                            </div>
                        </div>

                        <div id="aiLoadingBox" class="loading-box">
                            <div class="spinner"></div>
                            <span>Checking with AI...</span>
                        </div>

                        <div id="aiFeedbackAlert"
                             class="alert-box @(Model.ExplanationCorrect == true ? "alert-success-custom" : "alert-danger-custom")"
                             style="@(string.IsNullOrWhiteSpace(Model.ExplanationFeedback) ? "display:none;" : "")">
                            @Model.ExplanationFeedback
                        </div>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="btn-secondary" onclick="showStep(1)" id="backToStep1Button">Back</button>
                        <div class="step-progress">Step 2 of 2</div>

                        <div class="step-two-actions">
                            <button type="button"
                                    class="btn-main"
                                    id="checkExplanationButton"
                                    @(explanationAlreadyCorrect ? "disabled" : "")>
                                @(explanationAlreadyCorrect ? "Checked" : "Check with AI")
                            </button>

                            <button type="submit"
                                    name="actionType"
                                    value="submit"
                                    class="btn-main"
                                    id="submitLessonButton"
                                    style="@(Model.ExplanationCorrect == true ? "" : "display:none;")">
                                Mark Lesson as Complete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="nav-footer">
            <a asp-controller="UnitOne" asp-action="WhatIsComputerScience" class="btn-secondary">Back to Lesson 1</a>
            <a asp-controller="UnitOne" asp-action="Decomposition" class="btn-main">Next Lesson</a>
        </div>
    </div>
</div>

<script>
    function showStep(stepNumber) {
        document.querySelectorAll('.step-card').forEach(card => {
            card.classList.remove('active');
        });

        const target = document.getElementById(`step${stepNumber}`);
        if (target) {
            target.classList.add('active');
        }

        const hiddenStep = document.getElementById('CurrentStep');
        if (hiddenStep) {
            hiddenStep.value = stepNumber;
        }
    }

    function markExplanationCheckedState(isChecked) {
        const checkButton = document.getElementById('checkExplanationButton');

        if (!checkButton) return;

        checkButton.disabled = isChecked;
        checkButton.textContent = isChecked ? 'Checked' : 'Check with AI';
    }

    function setStepTwoLoadingState(isLoading) {
        const loadingBox = document.getElementById('aiLoadingBox');
        const checkButton = document.getElementById('checkExplanationButton');
        const backButton = document.getElementById('backToStep1Button');
        const explanationInput = document.getElementById('ExplanationAnswer');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');

        const alreadyChecked = explanationCorrectHidden && explanationCorrectHidden.value === 'true';

        if (loadingBox) {
            loadingBox.classList.toggle('active', isLoading);
        }

        if (checkButton) {
            if (isLoading) {
                checkButton.disabled = true;
                checkButton.textContent = 'Checking...';
            } else {
                markExplanationCheckedState(alreadyChecked);
            }
        }

        if (backButton) {
            backButton.disabled = isLoading;
        }

        if (explanationInput) {
            explanationInput.readOnly = isLoading;
        }
    }

    function setAiResult(isCorrect, feedback) {
        const feedbackDisplay = document.getElementById('aiFeedbackDisplay');
        const feedbackAlert = document.getElementById('aiFeedbackAlert');
        const submitLessonButton = document.getElementById('submitLessonButton');
        const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
        const explanationFeedbackHidden = document.getElementById('ExplanationFeedbackHidden');

        if (feedbackDisplay) {
            feedbackDisplay.value = feedback || '';
        }

        if (feedbackAlert) {
            feedbackAlert.style.display = 'block';
            feedbackAlert.textContent = feedback || '';
            feedbackAlert.classList.remove('alert-success-custom', 'alert-danger-custom');
            feedbackAlert.classList.add(isCorrect ? 'alert-success-custom' : 'alert-danger-custom');
        }

        if (explanationCorrectHidden) {
            explanationCorrectHidden.value = isCorrect ? 'true' : 'false';
        }

        if (explanationFeedbackHidden) {
            explanationFeedbackHidden.value = feedback || '';
        }

        if (submitLessonButton) {
            submitLessonButton.style.display = isCorrect ? '' : 'none';
        }

        markExplanationCheckedState(isCorrect);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const currentStep = parseInt(document.getElementById('CurrentStep')?.value || '0');
        showStep(currentStep);

        markExplanationCheckedState(@(Model.ExplanationCorrect == true ? "true" : "false"));

        const checkExplanationButton = document.getElementById('checkExplanationButton');

        if (checkExplanationButton) {
            checkExplanationButton.addEventListener('click', async function () {
                const explanationCorrectHidden = document.getElementById('ExplanationCorrectHidden');
                if (explanationCorrectHidden && explanationCorrectHidden.value === 'true') {
                    markExplanationCheckedState(true);
                    return;
                }

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const explanationAnswer = document.getElementById('ExplanationAnswer')?.value ?? '';

                setStepTwoLoadingState(true);

                try {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
                    formData.append('explanationAnswer', explanationAnswer);

                    const response = await fetch('@Url.Action("CheckAlgorithmsExplanation", "UnitOne")', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        setAiResult(false, data.feedback || 'We could not check your explanation right now.');
                        return;
                    }

                    setAiResult(data.isCorrect, data.feedback);
                } catch (error) {
                    setAiResult(false, 'We could not check your explanation right now. Please try again.');
                } finally {
                    setStepTwoLoadingState(false);
                }
            });
        }
    });
</script>